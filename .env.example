TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Decisions that are notified: top_match (blue), shortlist (green), review (yellow). skip is never notified. Anyone who lists
# shortlist also receives top_match. The default is all three.
TELEGRAM_NOTIFY_DECISIONS=top_match,shortlist,review
# Most Telegram alerts sent in one run, across all sources; the best ones first, the rest stay pending for the next run.
MAX_TELEGRAM_ALERTS_PER_RUN=5
DATABASE_PATH=./data/job-sniper.db
DRY_RUN=true

# Sources collected in each run, comma separated: 99freelas, remotive, freelancer. The default is 99freelas alone.
SOURCES=99freelas
# Freelancer.com Personal Access Token (official API). Put the value only in your local .env; it is valid for 30 days.
FREELANCER_OAUTH_TOKEN=
# Freelancer.com listing pages read per run, 20 projects each (1 to 10, default 5). Only this source uses it.
FREELANCER_MAX_PAGES=5
# Remotive: hours between queries to its API (at least 6; its documentation advises at most 4 queries a day).
REMOTIVE_MIN_INTERVAL_HOURS=6

# Discovery, per run. Independent limits: the first one reached stops the scan.
#   DISCOVERY_MAX_PAGES  listing pages read
#   DISCOVERY_TARGET_NEW NEW summaries saved (already-known ones do not count)
#   MAX_DETAILS_PER_RUN  detail pages opened (split between new and older pending items)
# The code defaults are the same as below.
MAX_DETAILS_PER_RUN=20
DISCOVERY_MAX_PAGES=20
DISCOVERY_TARGET_NEW=100

# AI analysis (Gemini free tier). Keep AI_ENABLED=false until the key is in your local .env.
AI_ENABLED=false
AI_PROVIDER=gemini
AI_MODEL=gemini-3.6-flash
GEMINI_API_KEY=
AI_MAX_ANALYSES_PER_RUN=20

# Gemini quota controls (local counter, kept in the database)
GEMINI_MIN_INTERVAL_SECONDS=15
GEMINI_MAX_REQUESTS_PER_DAY=20
